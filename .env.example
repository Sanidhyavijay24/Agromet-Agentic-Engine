# ─────────────────────────────────────────────────────────────────────────────
#  SIH 26074: AI/ML Weather Downscaling — Environment Configuration Template
#  Copy this file to .env and populate the values before running any service.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── General ─────────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production

# ── API Gateway ──────────────────────────────────────────────────────────────
FASTAPI_PORT=8000
FASTAPI_HOST=0.0.0.0
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ── IMD Data Access ───────────────────────────────────────────────────────────
# Obtain from IMD Data Services Portal (https://dsp.imdpune.gov.in/)
IMD_API_KEY=

# ── Copernicus Climate Data Store ─────────────────────────────────────────────
# Register at https://cds.climate.copernicus.eu/ then find your UID:KEY in profile
# The ~/.cdsapirc file is the primary credential source; these are env overrides.
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=

# ── OpenRouter LLM API ────────────────────────────────────────────────────────
# Obtain at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=SIH-Microclimate-Downscaler

# ── Open-Meteo (public, no key required for standard tiers) ───────────────────
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation

# ── NASA POWER Agroclimatology ────────────────────────────────────────────────
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# ── Default Location (Jaipur rural fringe — Chaksu tehsil) ────────────────────
DEFAULT_LATITUDE=26.9124
DEFAULT_LONGITUDE=75.7873
DEFAULT_DISTRICT=Jaipur
DEFAULT_STATE=Rajasthan

# ── MOSDAC / ISRO ─────────────────────────────────────────────────────────────
MOSDAC_API_KEY=
MOSDAC_USERNAME=
MOSDAC_PASSWORD=
MOSDAC_BASE_URL=https://mosdac.gov.in

# ── Bhoonidhi / NRSC / ISRO ───────────────────────────────────────────────────
BHOONIDHI_BASE_URL=https://bhoonidhi-api.nrsc.gov.in
BHOONIDHI_USER_ID=
BHOONIDHI_PASSWORD=

# ── USGS Machine-to-Machine (M2M) API ─────────────────────────────────────────
# Obtain from USGS EROS M2M Portal (https://m2m.cr.usgs.gov/)
USGS_M2M_TOKEN=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_IP=100                # requests per 15-minute window
RATE_LIMIT_USER=1000             # requests per hour per authenticated user

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
CORS_ORIGINS=http://localhost:3000

# ── Database (optional — for persistent storage phase) ────────────────────────
DATABASE_URL=sqlite:///./data/processed/sih_weather.db

# ── Firebase (Frontend — वाता Farmer Phone OTP Auth) ─────────────────────────
# Create a Firebase project at https://console.firebase.google.com/
# Enable "Phone" sign-in method under Authentication → Sign-in method
# Add your app domain to "Authorized domains"
# Copy these values from Project Settings → General → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── USGS M2M API (30m SRTM Digital Elevation Model) ───────────────────────────
# Obtain from USGS EROS EROS Inventory / M2M portal
USGS_M2M_TOKEN=

